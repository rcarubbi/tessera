{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "TesseraDb": "Host=localhost;Port=5432;Database=tessera;Username=tessera;Password=tessera"
  },
  "Sidecar": {
    "BaseUrl": "http://localhost:4350"
  },
  "Worker": {
    "WorkRoot": "work"
  },
  "ObjectStore": {
    "Root": "objects"
  },
  "Ai": {
    "Providers": [
      {
        "Name": "deepseek",
        "BaseUrl": "https://api.deepseek.com",
        "ApiKey": "",
        "Model": "deepseek-chat"
      },
      {
        "Name": "qwen",
        "BaseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "ApiKey": "",
        "Model": "qwen-plus"
      }
    ],
    "Primary": "deepseek",
    "Fallback": "qwen",
    "LargeTier": "deepseek",
    "ComplexityThresholdLines": 200,
    "DailyBudgetTokens": 2000000,
    "ReviewThreshold": 0.7,
    "MaxRetries": 3
  }
}
